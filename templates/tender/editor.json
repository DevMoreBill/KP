          "label": "Высота подписи",
          "unit": "см",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "hint": "0 — по пропорциям картинки."
        },
        {
          "key": "rules.stampWidthCm",
          "type": "number",
          "label": "Диаметр (ширина) печати",
          "unit": "см",
          "min": 2,
          "max": 6,
          "step": 0.1
        },
        {
          "key": "rules.stampX",
          "type": "number",
          "label": "Печать: сдвиг вправо от края текста",
          "unit": "см",
          "min": -3,
          "max": 15,
          "step": 0.1
        },
        {
          "key": "rules.stampY",
          "type": "number",
          "label": "Печать: сдвиг по вертикали от «М.П.»",
          "unit": "см",
          "min": -6,
          "max": 3,
          "step": 0.1,
          "hint": "Минус — выше строки «М.П.», на подпись."
